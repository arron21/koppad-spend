# Copy this file to .env and fill in your Plaid API credentials to enable live / Plaid Sandbox bank linking.
# Without these keys, KopPad Spend runs in built-in Local Sandbox / Mock Bank Sync mode out of the box!

PLAID_CLIENT_ID=
PLAID_SECRET=
# Options: sandbox | development | production
PLAID_ENV=sandbox

# Optional server port (default: 3001)
PORT=3001
