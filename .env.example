# 1. Security Passcode (REQUIRED in production to lock your financial KopPad!)
APP_PASSWORD=choose-a-strong-passcode-here

# Optional secret keys (if omitted, securely derived from APP_PASSWORD)
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# 2. Permanent Cloud Database (Neon / Vercel Postgres / Supabase PostgreSQL)
# Connecting Neon or Vercel Postgres in the Vercel Storage tab automatically sets DATABASE_URL / POSTGRES_URL!
DATABASE_URL=

# 3. Plaid Credit & Debit Card Sync
PLAID_CLIENT_ID=
PLAID_SECRET=
# Options: sandbox | development | production
PLAID_ENV=sandbox

# Optional local server port (default: 3001)
PORT=3001
