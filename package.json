{
  "name": "koppad-spend",
  "version": "1.0.0",
  "private": true,
  "description": "Pikmin 3 Day-End Spending Report web app with CSV uploads, Plaid credit/debit card sync, Sunset Sync scheduler, and SQLite persistence.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "build:web": "vite build",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.23.1",
    "plaid": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.6"
  }
}
